; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Skies of Aerwyth"
run/main_scene="res://scenes/world/journey.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=640
window/size/min_height=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

camera_pan_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
camera_pan_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
camera_pan_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
camera_pan_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
camera_look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}
camera_look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}
camera_look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}
camera_look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}
camera_rotate_hold={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
select_ship={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
camera_focus_fleet={
"deadzone": 0.2,
"events": []
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
camera_zoom_in_hold={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":11)]
}
camera_zoom_out_hold={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"button_index":12)]
}
camera_sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)]
}
debug_navigation={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}

[physics]

common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
