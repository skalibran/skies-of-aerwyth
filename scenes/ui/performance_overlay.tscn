[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/performance_overlay.gd" id="1"]

[node name="PerformanceOverlay" type="MarginContainer"]
mouse_filter = 2
theme_type_variation = &"HUDMargin"
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
mouse_filter = 2
theme_type_variation = &"PerformancePanel"

[node name="StatsLabel" type="Label" parent="Panel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PerformanceLabel"
text = "Ships: 0  |  FPS: 0"

[node name="RefreshTimer" type="Timer" parent="."]
wait_time = 0.5
autostart = true

[connection signal="timeout" from="RefreshTimer" to="." method="_update_label"]
