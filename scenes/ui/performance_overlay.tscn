[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/performance_overlay.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="StatsPanel"]
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0
bg_color = Color(0.02, 0.04, 0.06, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

[node name="PerformanceOverlay" type="CanvasLayer"]
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StatsPanel")

[node name="StatsLabel" type="Label" parent="Margin/Panel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 20
text = "Ships: 0  |  FPS: 0"

[node name="RefreshTimer" type="Timer" parent="."]
wait_time = 0.5
autostart = true

[connection signal="timeout" from="RefreshTimer" to="." method="_update_label"]
