[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/wave_announcement.gd" id="1"]

[node name="WaveAnnouncement" type="MarginContainer"]
visible = false
mouse_filter = 2
theme_type_variation = &"HUDMargin"
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 0
mouse_filter = 2
theme_type_variation = &"WavePanel"

[node name="WaveLabel" type="Label" parent="Panel"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"WaveLabel"
text = "Wave 1  |  Difficulty: 10"
horizontal_alignment = 1

[node name="DisplayTimer" type="Timer" parent="."]
one_shot = true

[connection signal="timeout" from="DisplayTimer" to="." method="hide"]
